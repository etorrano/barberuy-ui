  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "ssr": "npm run build && node server/index.ts",
    "build:edge": "webpack --config webpack.edge.js",
    "build:lambda": "webpack --config webpack.lambda.js",
    "build:server": "webpack --stats-error-details --config webpack.server.js",
    "test": "react-scripts test",
    "test:lambda": "node -e \"console.log(require('./dist/index.js').handler(require('./event.json')));\"",
